        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디렉토리에 이미 같은 이름의 파일이 존재합니다. 이대로 추가하면 덮어쓰거나 충돌이 발생할 수 있습니다. 어떻게 진행할지 선택하세요:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該目錄下已存在同名文件，直接增加可能會覆寫或產生衝突。請選擇如何操作："
          }
        }
      }
    },
